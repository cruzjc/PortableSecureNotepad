<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PortableSecureNotepad.Core\PortableSecureNotepad.Core.csproj" />
    <EmbeddedResource Include="Assets\App.ico" LogicalName="PortableSecureNotepad.AppIcon.ico" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>PortableSecureNotepad</AssemblyName>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

</Project>
